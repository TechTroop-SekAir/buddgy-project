# Base URL of the server's /api, e.g. http://localhost:4000/api
VITE_API_URL=

# Set to "true" to use the in-memory mock auth backend (client/src/services/
# mockAuthService.js) instead of calling the real API. Flip to "false"/unset
# once the backend's auth endpoints are live (ticket A-09).
VITE_USE_MOCK_API=true

# Set to "true" to use the local mock Google Calendar flow (client/src/services/
# mockCalendarService.js + mockPlannedExpenseService.js) instead of real OAuth.
# Independent of VITE_USE_MOCK_API on purpose — flipping that one also mocks
# auth, which breaks the always-real categoryService.js/transactionService.js.
# Lets a real, logged-in dev seed planned expenses locally (Settings → Connect
# → Sync) to test forecast/at-risk logic (ticket A-13) without live Google
# OAuth credentials.
VITE_USE_MOCK_CALENDAR=false

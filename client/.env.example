# Base URL of the server's /api, e.g. http://localhost:4000/api
VITE_API_URL=

# Set to "true" to use the in-memory mock auth backend (client/src/services/
# mockAuthService.js) instead of calling the real API. Flip to "false"/unset
# once the backend's auth endpoints are live (ticket A-09).
VITE_USE_MOCK_API=true

# Set to "true" to use the local mock Google Calendar OAuth flow
# (client/src/services/mockCalendarService.js) instead of real OAuth.
# Independent of VITE_USE_MOCK_API on purpose — flipping that one also mocks
# auth, which breaks the always-real categoryService.js/transactionService.js.
# Lets a real, logged-in dev exercise Settings → Connect → Sync without live
# Google OAuth credentials.
VITE_USE_MOCK_CALENDAR=false

# Set to "true" to use the local mock planned-expense CRUD (client/src/services/
# mockPlannedExpenseService.js) instead of the real, working
# GET/POST/PATCH/DELETE /api/planned-expenses endpoints. Independent of
# VITE_USE_MOCK_CALENDAR on purpose — planned-expense CRUD isn't a Google API
# call, so it stays real even when the Calendar OAuth dance is mocked (see
# docs/TESTING.md § Mocking Policy: only Google Calendar and Claude are mocked).
VITE_USE_MOCK_PLANNED_EXPENSES=false

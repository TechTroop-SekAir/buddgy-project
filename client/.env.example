# Base URL of the server's /api, e.g. http://localhost:4000/api
VITE_API_URL=

# Set to "true" to use the in-memory mock auth backend (client/src/services/
# mockAuthService.js) instead of calling the real API. Flip to "false"/unset
# once the backend's auth endpoints are live (ticket A-09).
VITE_USE_MOCK_API=true

# Postgres connection string, e.g. postgres://user:pass@localhost:5432/buddgy_dev
DATABASE_URL=
# Connection string for the DEDICATED test database (ticket B-09) — a separate
# database from DATABASE_URL, e.g. postgres://user:pass@localhost:5432/buddgy_test.
# `npm run test:integration` / `db:migrate:test` swap DATABASE_URL to this value
# for their process only, so integration tests never touch dev data. Create it
# locally with `scripts/create-test-db.sh` (same Postgres container, second DB).
DATABASE_URL_TEST=
# Long random string used to sign JWTs
JWT_SECRET=
# Origin the server allows CORS from, e.g. http://localhost:5173
CLIENT_URL=
# Port the Express server listens on, e.g. 4000
PORT=
# development | test | production
NODE_ENV=
# Google OAuth2 app credentials (Calendar sync) — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 32-byte hex key used to encrypt google_refresh_token at rest (AES-256-GCM)
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Anthropic Claude API key — powers AI Quick Entry + CSV mapping
ANTHROPIC_API_KEY=
# Cloudinary connection URL — external storage for avatars + CSV files
CLOUDINARY_URL=

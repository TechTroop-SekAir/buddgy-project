# Postgres connection string, e.g. postgres://user:pass@localhost:5432/buddgy_dev
DATABASE_URL=
# Long random string used to sign JWTs
JWT_SECRET=
# Origin the server allows CORS from, e.g. http://localhost:5173
CLIENT_URL=
# Port the Express server listens on, e.g. 4000
PORT=
# development | test | production
NODE_ENV=
# Google OAuth2 app credentials (Calendar sync) — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Anthropic Claude API key — powers AI Quick Entry + CSV mapping
ANTHROPIC_API_KEY=
# Cloudinary connection URL — external storage for avatars + CSV files
CLOUDINARY_URL=
